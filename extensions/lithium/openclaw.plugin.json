{
  "id": "lithium",
  "name": "Lithium Sandbox",
  "description": "Run shell commands and code in a managed Lithium Linux sandbox via wxc-exec. Acquires AAD tokens in-process via `az`.",
  "activation": { "onStartup": true },
  "skills": ["skills/lithium-exec"],
  "contracts": {
    "tools": ["lithium_exec"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["cliPath", "tenantId", "partnerId", "imageId", "shapeName"],
    "properties": {
      "cliPath": {
        "type": "string",
        "minLength": 1,
        "description": "Absolute path to the wxc-exec binary."
      },
      "tenantId": {
        "type": "string",
        "minLength": 1,
        "description": "Entra/AAD tenant id used for `az account get-access-token --tenant <id>`."
      },
      "partnerId": {
        "type": "string",
        "minLength": 1,
        "description": "Lithium partner identifier."
      },
      "imageId": {
        "type": "string",
        "minLength": 1,
        "description": "Lithium image id (e.g. `azlinuxnginxcmd`)."
      },
      "shapeName": {
        "type": "string",
        "minLength": 1,
        "description": "Lithium shape name (e.g. `4c8g`)."
      },
      "poolId": {
        "type": "string",
        "minLength": 1,
        "default": "default",
        "description": "Lithium pool id."
      },
      "environment": {
        "type": "string",
        "enum": ["test", "int"],
        "default": "test",
        "description": "Lithium service environment. Selects API endpoint and AAD scopes from a hardcoded table."
      },
      "azPath": {
        "type": "string",
        "minLength": 1,
        "default": "az",
        "description": "Path to the `az` CLI. Defaults to `az` on PATH."
      },
      "defaultTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "default": 300000,
        "description": "Per-call timeout in milliseconds, used when the tool's `timeout` arg is omitted."
      },
      "maxIdleSeconds": {
        "type": "integer",
        "minimum": 1,
        "default": 3600,
        "description": "Lithium sandbox idle timeout (seconds)."
      },
      "maxLifetimeSeconds": {
        "type": "integer",
        "minimum": 1,
        "default": 86400,
        "description": "Lithium sandbox max lifetime (seconds)."
      },
      "destroyOnExit": {
        "type": "boolean",
        "default": true,
        "description": "Destroy the Lithium sandbox after each invocation."
      },
      "ports": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "policy", "protocol"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "policy": { "type": "string", "enum": ["Owner"] },
            "protocol": { "type": "string", "enum": ["Http", "Https"] }
          }
        }
      }
    }
  }
}
